# Added by Earlyward: never run PHP from the uploads folder.
# Delete this file to undo; uploaded images and documents are not affected.
<FilesMatch "\.(php[0-9]?|phtml|phar|pht|phps)(\.|$)">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>
